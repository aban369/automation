# GEMINI_API_KEY: Required for Gemini AI API calls (research, scripts, fact-checking, TTS, transcription).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET (or YOUTUBE_CLIENT_ID & YOUTUBE_CLIENT_SECRET):
# OAuth 2.0 Web Application credentials from Google Cloud Console (APIs & Services -> Credentials).
# Required to connect real YouTube channels and access YouTube Data API v3.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
YOUTUBE_CLIENT_ID="MY_YOUTUBE_OAUTH_CLIENT_ID"
YOUTUBE_CLIENT_SECRET="MY_YOUTUBE_OAUTH_CLIENT_SECRET"

# TOKEN_ENCRYPTION_KEY: Optional Base64-encoded 32-byte key (or 64-character hex string) for AES-256-GCM encryption of OAuth tokens.
# If omitted, a persistent local master key is generated in ./data/.master.key.
TOKEN_ENCRYPTION_KEY=""

# PEXELS_API_KEY: Optional Pexels API key for additional licensed stock video and photo search.
# Built-in Wikimedia Commons, NASA Images, and Openverse licensed media search work without extra keys.
PEXELS_API_KEY=""

# MINIMAX_API_KEY: Official MiniMax API key for Hailuo / H3 Video-01 generation (Text-to-Video, Image-to-Video, First/Last Frame).
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""

# TAVILY_API_KEY: Optional API key for Tavily AI web search in Research Studio.
TAVILY_API_KEY=""

# FIRECRAWL_API_KEY: Optional API key for Firecrawl deep web page scraping and markdown extraction.
FIRECRAWL_API_KEY=""

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for public competitor research without OAuth.
YOUTUBE_API_KEY=""

# VOICEBOX_API_URL: Optional remote Voicebox FastAPI endpoint (e.g. 'https://voicebox.example.com').
# When omitted, CreatorOS AI uses its built-in cloud Voicebox Kokoro acoustic DSP engine.
VOICEBOX_API_URL=""
VOICEBOX_API_KEY=""

# OPENMONTAGE_OUTPUT_QUALITY: Default output encoding preset ('fast', 'medium', 'slow').
OPENMONTAGE_OUTPUT_QUALITY="fast"

